<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ace_run</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <EmbeddedResource Include="Assets\app-icon.ico">
      <LogicalName>ace_run.Assets.app-icon.ico</LogicalName>
    </EmbeddedResource>
    <!-- Same file again as a loose copy. AppWindow.SetIcon takes a *path*, so the window
         icon (Alt+Tab, taskbar) needs it on disk; the EmbeddedResource above is for the
         tray, which takes a stream. See WindowIconService. -->
    <Content Include="Assets\app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings\en-US\Resources.resw">
      <LogicalName>ace_run.Strings.en-US.Resources.resw</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Strings\zh-TW\Resources.resw">
      <LogicalName>ace_run.Strings.zh-TW.Resources.resw</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Strings\ja-JP\Resources.resw">
      <LogicalName>ace_run.Strings.ja-JP.Resources.resw</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <!--
    The logic layer. It lives outside win/ on purpose: this project has no <Compile> items
    at all and relies entirely on the SDK's default globbing, so anything placed under win/
    would be compiled into the app as well as into its own assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\core\AceRun.Core\AceRun.Core.csproj" />
  </ItemGroup>

  <!--
    The MCP automation server, published into the same folder as the app.

    A post-publish MSBuild call rather than a ProjectReference, and that is the point: a
    reference would pull ModelContextProtocol and Microsoft.Extensions.Hosting into this
    project's output, which is exactly what 12-mcp-automation.md §A1 keeps confined to mcp/.
    Nothing in the app calls the server — they talk over a named pipe — so there is no
    compile-time dependency to express.

    Same folder is a contract, not a convenience: AutomationLayout is how each half finds the
    other, so the server can start the app on demand and the settings window can write out a
    client configuration with a real path in it. Neither works from a development build, where
    each project has its own bin.

    The overrides matter. Platform: this project is x86/x64/ARM64 and the server is AnyCPU, so
    the inherited value would be refused outright. PublishProfile: a profile name passed on the
    command line is a global property and would send MSBuild looking for a profile of that name
    under mcp/. WindowsAppSDKSelfContained: the server has no WinAppSDK reference to bundle.
    SelfContained and the RID are inherited on purpose, so the two executables end up framework-
    dependent or self-contained together — and when they are self-contained they share one copy
    of the runtime, since the files are identical and land on top of each other.
  -->
  <!-- -p:PublishAutomationServer=false publishes the app on its own, which is how the size
       figures in CLAUDE.md were measured. -->
  <Target Name="PublishAutomationServer" AfterTargets="Publish"
          Condition="'$(PublishAutomationServer)' != 'false'">
    <!--
      Restored first, and in a call of its own. The server is not a ProjectReference, so the
      outer publish never restores it, and a RID-specific publish of a project whose assets
      file has no RID target fails with NETSDK1047. The extra property is there to make this a
      different project instance from the publish below, since restore has to finish before
      that one is evaluated.
    -->
    <MSBuild Projects="..\mcp\AceRun.Mcp\AceRun.Mcp.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier);PublishProfile=;PublishProfileFullPath=;_AceRunRestorePass=true" />

    <MSBuild Projects="..\mcp\AceRun.Mcp\AceRun.Mcp.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);PublishReadyToRun=$(PublishReadyToRun);PublishSingleFile=false;PublishTrimmed=false;WindowsAppSDKSelfContained=false;PublishProfile=;PublishProfileFullPath=" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

	<!-- Publish Properties -->
	<PropertyGroup>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
		<PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

		<!--
			Never trim. WinUI 3 resolves XAML types by reflection and this app also binds
			WScript.Shell through `dynamic` (ResolveLnkTarget), so the trimmer removes
			metadata nothing statically references. A trimmed publish builds and installs
			happily and then dies on startup with 0xC000027B inside Microsoft.UI.Xaml.dll.

			This line used to read
			  Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' == 'true'"
			which was inert while SelfContained was false. Turning SelfContained on armed it,
			and — only on the publish paths where the profile's properties are in scope before
			this one is evaluated, e.g. Visual Studio's Publish — it produced exactly that
			crash. Trimming also flips
			System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault to false, which would
			take DataService's whole config layer down with it.
		-->
		<PublishTrimmed>false</PublishTrimmed>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>
</Project>