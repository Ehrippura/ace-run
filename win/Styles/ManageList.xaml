<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The row shape shared by ManageWorkspacesDialog and ManageTagsDialog. The two used to be
        the same layout written twice, and had drifted apart in four ways - error bar, empty
        state, reordering, per-row colour - none of them deliberate.

        Styles only, no DataTemplate: a ResourceDictionary without an x:Class cannot host
        {x:Bind}, and every row binding here is x:Bind. The templates stay in their own dialogs
        (they genuinely differ - a workspace row carries an item count and an "in use" marker)
        and what is shared instead is the behaviour, in Services/ColorSwatchFlyout.cs and
        Services/ManageRowMenu.cs.

        Merged app-level rather than into each dialog's Resources, and not only to avoid two
        copies of every Style: the swatch picker and the overflow menu are built in code and
        parented on the popup root, whose lookup chain reaches Application.Resources but not a
        ContentDialog's local Resources.

        No colours here. Every colour lives in Brushes.xaml - see CLAUDE.md, "Design layer".
    -->

    <!--
        Padding is taller than the rail's 12,4 because the row holds a TextBox rather than a
        TextBlock. IsTabStop=False on the container is what keeps the row to three tab stops
        (swatch, name, overflow) instead of four; the container stop bought nothing, since
        SelectionMode="None" means it has no selection to receive and the ListView's own
        Ctrl+Shift+Arrow reorder is unreachable past the TextBox anyway.
    -->
    <Style x:Key="AceManageRowStyle" TargetType="ListViewItem"
           BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!--
        The drag affordance, and the reason it is a bare FontIcon rather than a Button: a
        TextBox or a Button captures the pointer on press, so it never reaches the
        ListViewItem's drag detection. Before this glyph existed, the only draggable surface on
        a workspace row was the 16-DIP colour dot and the gaps between columns, which is why
        reordering read as "sometimes works". This works only by being an inert hit-test
        surface that bubbles to the container - there is no public API to start a ListView
        reorder from code.
    -->
    <Style x:Key="AceRowGripperStyle" TargetType="FontIcon">
        <Setter Property="Glyph" Value="&#xE76F;" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- The current colour, and the button that opens the palette. A ring is drawn even when
         there is a fill, so a colourless workspace (transparent fill) reads as an empty slot
         rather than as nothing at all. -->
    <Style x:Key="AceSwatchButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The overflow button. Square, so a row of them lines up down the right edge. -->
    <Style x:Key="AceRowIconButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Inline rename. Fully chromed on purpose: this was a borderless, transparent TextBox
         that looked exactly like static text, so nothing said the name could be edited. A
         management dialog is the one place an editable field should look editable. -->
    <Style x:Key="AceRowNameBoxStyle" TargetType="TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

</ResourceDictionary>
