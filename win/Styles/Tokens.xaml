<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Spacing scale. Every margin/padding in the app resolves to one of these five
        steps; ad-hoc values like "12,35,12,0" are what this replaces.
    -->
    <x:Double x:Key="AceSpaceXs">4</x:Double>
    <x:Double x:Key="AceSpaceSm">8</x:Double>
    <x:Double x:Key="AceSpaceMd">12</x:Double>
    <x:Double x:Key="AceSpaceLg">16</x:Double>
    <x:Double x:Key="AceSpaceXl">24</x:Double>

    <Thickness x:Key="AceInsetSm">8</Thickness>
    <Thickness x:Key="AceInsetMd">12</Thickness>
    <Thickness x:Key="AceInsetLg">16</Thickness>

    <CornerRadius x:Key="AceCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AceRailItemCornerRadius">6</CornerRadius>

    <!--
        Type. No custom font is shipped: the app is trilingual (en-US / zh-TW / ja-JP)
        and any Latin display face would fall back inconsistently in CJK and break
        High Contrast. The pairing instead comes from Segoe UI Variable's three optical
        sizes. "Segoe UI" is the fallback for Windows 10, where the variable family
        does not exist (TargetPlatformMinVersion is 17763).
    -->
    <FontFamily x:Key="AceDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AceTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AceSmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

    <!--
        The main surface uses exactly two sizes: 14 (body) and 12 (caption).
        The former 11px and 13px literals are gone; 13 was off the Fluent ramp entirely.
    -->
    <Style x:Key="AceDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AceDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AceBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AceTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AceBodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource AceBodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AceCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AceSmallFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
