<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ace_run.ManageTagsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ace_run"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- The default is 548, which the five-column row outgrows: gripper, swatch, name,
             overflow and their gaps take about 130 DIP of chrome before the name box starts. -->
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <StackPanel MinWidth="440" Spacing="{StaticResource AceSpaceMd}">

        <Button x:Name="NewTagButton"
                Click="NewTagButton_Click"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <TextBlock x:Name="NewTagLabel" />
            </StackPanel>
        </Button>

        <!-- Duplicate names and nothing else, today. It exists mainly so this dialog has
             somewhere to say things at all — ManageWorkspacesDialog has had one all along. -->
        <InfoBar x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />

        <TextBlock x:Name="EmptyHint"
                   Visibility="Collapsed"
                   Style="{StaticResource AceCaptionStyle}"
                   TextWrapping="Wrap" />

        <!-- Reordering is not cosmetic: Organize "by tag" ranks on a tag's index in this
             collection, and NormalizeAppTags re-sorts every item's dots into the same order.
             The order was visible in those two places and editable in neither. -->
        <ListView x:Name="TagListView"
                  MaxHeight="360"
                  SelectionMode="None"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  ContainerContentChanging="TagListView_ContainerContentChanging"
                  ItemContainerStyle="{StaticResource AceManageRowStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TagViewModel">
                    <Grid ColumnSpacing="{StaticResource AceSpaceSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Style="{StaticResource AceRowGripperStyle}"
                                  ToolTipService.ToolTip="{x:Bind local:ManageTagsDialog.ReorderLabel}"
                                  AutomationProperties.AccessibilityView="Raw" />

                        <!-- Opens the palette. The face is the current colour, and the ring is
                             drawn regardless of fill so the dot reads as a slot. -->
                        <Button Grid.Column="1"
                                Tag="{x:Bind}"
                                Style="{StaticResource AceSwatchButtonStyle}"
                                Click="Swatch_Click"
                                ToolTipService.ToolTip="{x:Bind ColorName, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:ManageTagsDialog.ChooseColorLabel}">
                            <Ellipse Width="14" Height="14"
                                     Fill="{x:Bind ColorBrush, Mode=OneWay}"
                                     Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                     StrokeThickness="1" />
                        </Button>

                        <TextBox Grid.Column="2"
                                 Text="{x:Bind Name, Mode=OneWay}"
                                 Style="{StaticResource AceRowNameBoxStyle}"
                                 AutomationProperties.Name="{x:Bind local:ManageTagsDialog.NameFieldLabel}"
                                 GotFocus="TagName_GotFocus"
                                 LostFocus="TagName_LostFocus"
                                 KeyDown="TagName_KeyDown" />

                        <Button Grid.Column="3"
                                Tag="{x:Bind}"
                                Style="{StaticResource AceRowIconButtonStyle}"
                                Click="More_Click"
                                ToolTipService.ToolTip="{x:Bind local:ManageTagsDialog.MoreLabel}"
                                AutomationProperties.Name="{x:Bind local:ManageTagsDialog.MoreLabel}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </StackPanel>
</ContentDialog>
