<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>C:\Users\seruz\Desktop\export</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!--
      Two independent switches, and both are needed. SelfContained above bundles .NET;
      this one bundles the Windows App SDK. Without it the output contains no WinAppSDK
      binaries at all and the exe only starts where the WindowsAppRuntime redistributable
      is already installed — which is a dev-machine assumption, not a user one. It is not
      a Windows component, and it is version-band specific, so a machine carrying 1.6 still
      cannot run a 1.8 build.

      Dropping SelfContained while keeping this one publishes at 154 MB instead of 262 MB,
      but then the target needs the .NET 10 Desktop Runtime instead. Same problem, smaller.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>