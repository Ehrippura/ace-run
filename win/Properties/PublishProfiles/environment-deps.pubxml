<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>C:\Users\seruz\Desktop\export</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Neither runtime is bundled: no SelfContained, and no WindowsAppSDKSelfContained
      either. The target machine needs the .NET 10 Desktop Runtime *and* the
      WindowsAppRuntime redistributable already installed.

      Which redistributable is not a detail that can be left implicit. The 1.x line
      shipped one framework package per minor version (Microsoft.WindowsAppRuntime.1.6,
      .1.7, .1.8 — they install side by side and do not substitute for each other), so a
      machine could carry several and still be missing the one a given build wants. The
      2.x line collapses that into a single Microsoft.WindowsAppRuntime.2 serviced in
      place. This project targets Windows App SDK 2.4, so the requirement is
      WindowsAppRuntime 2.x — a 1.8 machine cannot run this output.
    -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>