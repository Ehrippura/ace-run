<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ace_run.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ace_run"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ace Run">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        RootGrid hosts every modified-key accelerator. It is an ancestor of all focusable
        elements, so invocation resolves along the focus chain rather than relying on the
        framework's whole-tree fallback, and unlike the rail's contents or a flyout's items
        it is never collapsed. Placement is Hidden because a Grid has no tooltip to hang
        the hint on — discoverability comes from KeyboardAcceleratorTextOverride on the
        menu items and AutomationProperties.AcceleratorKey on the buttons instead.

        Unmodified keys (Esc, F2, Delete, Down) are deliberately NOT accelerators: those
        would fire while SearchBox has focus. See MainWindow.Accelerators.cs.

        Both back gestures (Alt+Left, mouse XButton1) are bound in code instead of here,
        because they need handledEventsToo to survive the lists. See MainWindow.History.cs.
    -->
    <Grid x:Name="RootGrid"
          KeyboardAcceleratorPlacementMode="Hidden"
          KeyDown="RootGrid_KeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="AddApp_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="AddUrl_Invoked" />
            <!-- Menu = Alt. Note AltGr sends Ctrl+Alt on some European layouts. -->
            <KeyboardAccelerator Modifiers="Control,Menu" Key="N" Invoked="NewFolder_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="ToggleRail_Invoked" />
            <!-- Ctrl+, and Ctrl+1..9 are added in code: comma has no named VirtualKey, and
                 nine near-identical blocks is where declarative loses.
                 Alt+Enter is NOT here — see AppGridView_KeyDown. -->
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--
            The chrome is one row. The workspace picker, search, and the primary Add
            action all live in the title bar, which is what replaced a separate toolbar
            row plus a transparent 32px drag strip the toolbar had to dodge with
            Padding="12,35,12,0".

            A plain Grid, not Microsoft.UI.Xaml.Controls.TitleBar. That control reserves
            the caption strip in a template column whose width it takes straight from
            AppWindow.TitleBar.RightInset — which is in *physical pixels*, assigned into a
            DIP-valued ColumnDefinition. At 150% scaling that over-reserved 72 DIP on top
            of a hard-coded 48 DIP spacer, leaving a ~120 DIP hole between the gear button
            and the minimise button that no public property could shrink. Owning the
            columns makes the reserve one line of our own arithmetic; see
            UpdateTitleBarInsets() in MainWindow.TitleBar.cs.

            What the control supplied and this row re-implements: the back and pane-toggle
            buttons (ordinary Buttons now, which is also why their tooltips are localised —
            the SDK template hardcoded "Back"), and the dimming when the window loses
            focus. Everything else here was already ours.

            No app name or icon: the workspace picker is the only identity the window
            needs. The app name and icon repeated what the taskbar and the window's own
            Title already say, and pushed the search field — the actual hero — off centre.
        -->
        <Grid Grid.Row="0" x:Name="AppTitleBar">
            <Grid.ColumnDefinitions>
                <!-- Both inset columns are driven from AppWindow.TitleBar by
                     UpdateTitleBarInsets(). Zero in XAML so the first paint cannot show a
                     gap on the wrong side, and named for a side rather than for "caption"
                     because RTL puts the caption buttons on the left. -->
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Both chrome buttons ride NavigationBackButtonNormalStyle: it is the
                 platform's own 40x40 subtle-icon button, already wired to
                 SymbolThemeFontFamily, so the toggle only has to swap the glyph. Their
                 margins reproduce the spacing the SDK template used (2 / 4 / 2). -->
            <Button x:Name="BackButton" Grid.Column="1"
                Style="{StaticResource NavigationBackButtonNormalStyle}"
                Margin="2,0,0,0"
                IsEnabled="False"
                VerticalAlignment="Center"
                Click="BackButton_Click" />

            <Button x:Name="PaneToggleButton" Grid.Column="2"
                Style="{StaticResource NavigationBackButtonNormalStyle}"
                Margin="4,0,0,0"
                Content="&#xE700;"
                VerticalAlignment="Center"
                Click="PaneToggleButton_Click" />

            <!-- The 4 on the right is not slack: the ComboBox paints ~4 DIP short of its
                 layout slot, so this is what makes the visible gap to the search field
                 match the 30 the search field leaves on its other side. -->
            <ComboBox x:Name="WorkspaceComboBox" Grid.Column="3"
                MinWidth="140"
                Margin="2,0,4,0"
                VerticalAlignment="Center"
                SelectionChanged="WorkspaceComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:WorkspaceViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10"
                                     Fill="{x:Bind ColorBrush, Mode=OneWay}"
                                     Visibility="{x:Bind HasColorVisibility, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Search is the launcher's actual hero, so it sits centre stage: it is the
                 only star column, which is what centres it in the *window* rather than in
                 whatever the flanking columns left over.

                 Stretch with a MaxWidth and no MinWidth, so the field is elastic in both
                 directions: it grows with the window until 720 DIP and then stops (a
                 text field wider than that is harder to read, not easier), and it gives
                 way instead of overflowing when the window is dragged down to its 720 DIP
                 minimum. A MinWidth here would win over the column and push the field out
                 under the workspace picker. Stretch still reads as centred once MaxWidth
                 clamps it — a clamped Stretch centres in its slot.

                 The side margins are what keep it off the picker and the Add button, and
                 they are the *floor*: at the window's minimum width the star column is the
                 only thing that gives, so whatever is set here is the narrowest the gaps
                 ever get. 30 DIP — chosen by eye rather than off the spacing scale, which
                 tops out at 24; the field is the row's hero and wanted the extra air.
                 Measured, not derived: the picker's painted right edge sits ~4 DIP inside
                 its layout slot, so its own 4 DIP right margin is what makes both flanks
                 land on the same 30.

                 The sizing lives on this host Grid rather than on the box, because the
                 magnifier is a sibling that has to track the box exactly: once MaxWidth
                 clamps, a Stretch element centres in its slot, so a Left-aligned icon in
                 the *column* would sit 100+ DIP away from the field it belongs to. Inside
                 a host that is itself the clamped element, Left means the field's left. -->
            <Grid Grid.Column="4"
                MaxWidth="720"
                Margin="30,0,30,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                <!-- QueryIcon is null: the built-in one is a *button* pinned to the right of
                     the template, and there is no property that moves it. Leading glyph is
                     the search convention (and the direction the eye reads the field), so it
                     is drawn as an overlay instead and the TextBox is padded to clear it.
                     Nothing is lost with the button gone — Enter still raises QuerySubmitted,
                     and the clear "X" still appears on the right once there is text. The
                     glyph is decorative, hence IsHitTestVisible=False: a click there lands in
                     the field and puts the caret at the start, which is what a user aiming
                     at the left edge of a search box wants. -->
                <AutoSuggestBox x:Name="SearchBox"
                    x:Uid="SearchBox"
                    PlaceholderText="Search apps..."
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    QueryIcon="{x:Null}"
                    AutomationProperties.AcceleratorKey="Ctrl+F"
                    TextChanged="SearchBox_TextChanged"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    PreviewKeyDown="SearchBox_PreviewKeyDown">
                    <AutoSuggestBox.TextBoxStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                            <!-- Left is the platform's own 11 plus room for the 16 DIP glyph
                                 and the gap after it; the other three sides are the theme's
                                 TextControlThemePadding untouched. -->
                            <Setter Property="Padding" Value="35,5,6,6" />
                        </Style>
                    </AutoSuggestBox.TextBoxStyle>
                </AutoSuggestBox>

                <FontIcon Glyph="&#xE721;"
                    FontSize="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="11,0,0,0"
                    IsHitTestVisible="False"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- The right margin is the whole point of the exercise: a deliberate 12 DIP
                 of air before the caption buttons, instead of the SDK's 120. -->
            <StackPanel Grid.Column="5"
                    Orientation="Horizontal" Spacing="8"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <!-- Primary click keeps the .exe picker, dropdown adds a URL -->
                <SplitButton x:Name="AddButton"
                    Click="AddSplitButton_Click"
                    AutomationProperties.AcceleratorKey="Ctrl+N"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="AddButtonLabel" Text="Add" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="AddMenuAppItem"
                                Text="Add App"
                                KeyboardAcceleratorTextOverride="Ctrl+N"
                                Click="AddButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECAA;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="AddMenuUrlItem"
                                Text="Add URL"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
                                Click="AddUrlMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE774;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <!-- The two icon-only manage buttons collapse into one menu.
                     Button rather than DropDownButton: the latter always draws a
                     chevron, which reads as noise next to a lone gear glyph. -->
                <Button x:Name="SettingsButton"
                    Height="32"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ManageWorkspacesMenuItem"
                                Click="ManageWorkspacesButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE821;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ManageTagsMenuItem"
                                Click="ManageTagsButton_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8EC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content area: rail + content. SplitView rather than a fixed column so
             the rail can collapse at narrow widths; DisplayMode and IsPaneOpen are driven
             from Window.SizeChanged in code-behind. AdaptiveTrigger would mean a
             VisualStateManager on a bare Window rather than a Page, which is fragile. -->
        <SplitView Grid.Row="1"
            x:Name="RailSplitView"
            DisplayMode="Inline"
            IsPaneOpen="True"
            OpenPaneLength="200"
            PaneBackground="Transparent">

            <!-- Rail. Stays on bare Mica so the material reads through; the content
                 surface's own left stroke provides the separation. -->
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" x:Name="SidebarListView"
                        SelectionChanged="SidebarListView_SelectionChanged"
                        Tapped="SidebarListView_Tapped"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        DragOver="SidebarListView_DragOver"
                        DragLeave="SidebarListView_DragLeave"
                        Drop="SidebarListView_Drop"
                        DragItemsCompleted="SidebarListView_DragItemsCompleted"
                        KeyDown="SidebarListView_KeyDown"
                        ContainerContentChanging="SidebarListView_ContainerContentChanging"
                        Padding="4,4,4,4">
                        <ListView.Header>
                            <ListViewItem x:Name="UngroupedItem"
                                Tapped="UngroupedItem_Tapped"
                                Padding="12,4"
                                MinHeight="36"
                                HorizontalContentAlignment="Stretch">
                                <!-- Mirrors the folder row layout. This is still a
                                     ListView.Header rather than a real collection item,
                                     so the count is maintained in code. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Same highlight as a folder row. Toggled from code
                                         rather than bound: the header is not a view model. -->
                                    <Border x:Name="UngroupedDropHighlight"
                                        Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="-12,-4"
                                        CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                    <FontIcon Grid.Column="0"
                                        Glyph="&#xE8FD;" FontSize="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                        x:Name="UngroupedItemLabel"
                                        Style="{StaticResource AceBodyStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                        x:Name="UngroupedItemCount"
                                        Style="{StaticResource AceCaptionStyle}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </ListViewItem>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FolderViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Drop-target highlight. Behind the row content and
                                         spanning every column; the negative margin cancels
                                         the container's 12,4 padding so the fill reaches the
                                         row edges instead of floating as an inset pill.
                                         Achromatic on purpose — the rail already spends its
                                         colour budget on the workspace selection indicator,
                                         and this is the platform's own hover fill, which is
                                         what a drop target should look like. -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="-12,-4"
                                        CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{x:Bind DropTargetVisibility, Mode=OneWay}" />

                                    <FontIcon Grid.Column="0"
                                        Glyph="&#xE8B7;"
                                        FontSize="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                        Style="{StaticResource AceBodyStyle}"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <!-- Item count. FolderViewModel had no bindable
                                         visual information at all before this. -->
                                    <TextBlock Grid.Column="2"
                                        Style="{StaticResource AceCaptionStyle}"
                                        Text="{x:Bind AppCountText, Mode=OneWay}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"
                                BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- New Folder lives here because folders are rail objects.
                         Commands belong where their objects live. -->
                    <Button Grid.Row="1"
                        x:Name="NewFolderButton"
                        Click="NewFolderButton_Click"
                        AutomationProperties.AcceleratorKey="Ctrl+Alt+N"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4,4,4,4"
                        Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="NewFolderButtonLabel" Text="New Folder" />
                        </StackPanel>
                    </Button>
                </Grid>
            </SplitView.Pane>

            <!-- Content area. All chrome now lives in the title bar, so this is a
                 single row holding the three mutually exclusive views.
                 The layer fill lifts it off the Mica: previously the whole window was
                 bare backdrop, so nothing read as a surface. -->
            <Border
                x:Name="ContentSurface"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
            <Grid>

                <!-- App grid (normal mode) -->
                <GridView
                    x:Name="AppGridView"
                    Padding="12,12,4,4"
                    SelectionMode="Extended"
                    CanReorderItems="True"
                    CanDragItems="True"
                    AllowDrop="True"
                    DoubleTapped="AppGridView_DoubleTapped"
                    DragItemsStarting="AppGridView_DragItemsStarting"
                    DragOver="AppGridView_DragOver"
                    Drop="AppGridView_Drop"
                    DragItemsCompleted="AppGridView_DragItemsCompleted"
                    RightTapped="AppGridView_RightTapped"
                    PreviewKeyDown="AppGridView_KeyDown"
                    ContainerContentChanging="AppGridView_ContainerContentChanging">
                    <!-- The item container supplies the card fill (rest / hover /
                         selected) via ListViewItemPresenter, so the template Border stays
                         transparent and only draws the stroke. Radius must match the
                         Border's or the hover fill corners won't line up. -->
                    <GridView.Resources>
                        <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                    </GridView.Resources>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppItemViewModel">
                            <!-- The transform exists for the launch pulse. Hover and press
                                 states come from the container's ListViewItemPresenter,
                                 which already themes correctly including High Contrast. -->
                            <Border Width="124" Height="118"
                                CornerRadius="{StaticResource AceCardCornerRadius}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="Transparent"
                                RenderTransformOrigin="0.5,0.5"
                                ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="8,10,8,2" Spacing="6">
                                        <Grid Height="48">
                                            <Image
                                                Source="{x:Bind IconSource, Mode=OneWay}"
                                                Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                                Width="48" Height="48"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Stretch="Uniform" />
                                            <!-- Shown for URLs and for exe items whose icon can't be read -->
                                            <FontIcon
                                                Glyph="{x:Bind FallbackGlyph}"
                                                Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"
                                                FontSize="32"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource AceCaptionStyle}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"
                                            MaxLines="2"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Tag colours as dots on their own row, centred under
                                         the label. The dot was never the problem with the
                                         original design — its position was: inline beside
                                         the label it stole width and knocked the name off
                                         centre. In its own row it does neither, and it
                                         stays clear of the selection border (a full-width
                                         bottom-edge bar collided with it). Matches the dots
                                         used in search result rows, so tags read the same
                                         in both views. The strip has a fixed height so an
                                         untagged card is exactly as tall as a tagged one.
                                         The automation name is on the strip, not on each
                                         dot: named individually a screen reader reads them
                                         one at a time. -->
                                    <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Height="16"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind TagsSummary, Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind VisibleTags, Mode=OneWay}"
                                            VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:TagViewModel">
                                                    <Ellipse Width="7" Height="7"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind ColorBrush, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            Style="{StaticResource AceCaptionStyle}"
                                            Text="{x:Bind OverflowLabel, Mode=OneWay}"
                                            Visibility="{x:Bind OverflowVisibility, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Search results (filtered mode) -->
                <ListView
                    x:Name="SearchResultsView"
                    Visibility="Collapsed"
                    Padding="8,0,8,8"
                    SelectionMode="Extended"
                    DoubleTapped="SearchResultsView_DoubleTapped"
                    RightTapped="SearchResultsView_RightTapped"
                    PreviewKeyDown="SearchResultsView_KeyDown"
                    ContainerContentChanging="SearchResultsView_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppItemViewModel">
                            <Grid Padding="4,4"
                                MinHeight="32"
                                ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                    Source="{x:Bind IconSource, Mode=OneWay}"
                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                    Width="20" Height="20"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform" />
                                <FontIcon Grid.Column="0"
                                    Glyph="{x:Bind FallbackGlyph}"
                                    Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"
                                    FontSize="16"
                                    Width="20"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind TagsVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind TagsSummary, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind VisibleTags, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:TagViewModel">
                                                <Ellipse Width="8" Height="8"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind ColorBrush, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Style="{StaticResource AceCaptionStyle}"
                                        Text="{x:Bind OverflowLabel, Mode=OneWay}"
                                        Visibility="{x:Bind OverflowVisibility, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                    Style="{StaticResource AceBodyStyle}"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    VerticalAlignment="Center" />

                                <!-- Containing folder (or "Ungrouped") -->
                                <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="12,0,4,0"
                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Style="{StaticResource AceCaptionStyle}"
                                        Text="{x:Bind FolderLabel, Mode=OneWay}"
                                        MaxWidth="120"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state (shown over Row 2 when there are no apps / no results) -->
                <!-- An empty screen is an invitation to act, so it carries a real
                     action. IsHitTestVisible stays on or the button can't be clicked. -->
                <StackPanel
                    x:Name="EmptyStateView"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon Glyph="&#xE7C3;"
                        FontSize="32"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="EmptyStateText"
                        Style="{StaticResource AceBodyStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        TextTrimming="None"
                        MaxWidth="280" />
                    <Button x:Name="EmptyStateAddButton"
                        x:Uid="EmptyStateAddButton"
                        Content="Add your first app"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="AddButton_Click" />
                </StackPanel>

            </Grid>
            </Border>
        </SplitView>

        <!--
            The workspace edge. Colour = the active workspace, crossfaded on switch.
            The workspace colour already existed in the data model but only ever rendered
            as a 10px dot you had to go and read; as a hairline around the whole window it
            makes "which workspace am I in" a peripheral-vision fact instead. That is this
            app's one real error mode - launching something in the wrong workspace.

            Last child of RootGrid so it draws over the title bar and the content surface,
            and RowSpan="2" so it is one unbroken rectangle rather than two segments. It
            must not take input: it sits on top of the caption buttons and the resize grip.
            Starts hidden: a workspace with no colour shows no edge at all, so the first
            paint must not flash the inactive grey before UpdateWorkspaceEdge runs.

            BorderBrush, Opacity and CornerRadius are all driven from MainWindow.Motion.cs -
            see UpdateWorkspaceEdge and UpdateWindowEdgeCorners.
        -->
        <Border x:Name="WorkspaceEdge"
            Opacity="0"
            Grid.Row="0"
            Grid.RowSpan="2"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False" />
    </Grid>
</Window>
