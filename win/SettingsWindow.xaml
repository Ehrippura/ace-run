<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ace_run.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ace_run"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The hotkey recorder listens here, not on its own button: capturing a chord that
         includes Alt can move focus out of the button (Alt+Space opens the window menu),
         and a handler hanging off the button would miss the rest of the chord. -->
    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <!--
                Hand-rolled rather than CommunityToolkit's SettingsCard. Six cards is not
                worth the project's second third-party dependency, and the shape is three
                columns and two text styles the design layer already defines.
            -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AceCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource AceInsetLg}" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <!-- The default ToggleSwitch reserves ~120 DIP for the "On"/"Off" label, which
                 is also untranslated. The header text is the label here. -->
            <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Caption row. No inset arithmetic like MainWindow's: nothing sits at the right
             edge, so the strip the caption buttons occupy can simply stay empty. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <TextBlock x:Name="WindowTitleText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource AceBodyStrongStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel Spacing="{StaticResource AceSpaceSm}">

                <TextBlock x:Name="GeneralGroupLabel"
                           Style="{StaticResource AceBodyStrongStyle}"
                           Margin="0,4,0,4" />

                <!-- Global hotkey -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HotkeyHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="HotkeyDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="HotkeyRecordButton"
                                    MinWidth="160"
                                    Click="HotkeyRecordButton_Click" />
                            <Button x:Name="HotkeyClearButton" Click="HotkeyClearButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="HotkeyInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Error" />

                <!-- Start with Windows -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StartupHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="StartupDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Name="StartupToggle"
                                      Style="{StaticResource SettingsToggleStyle}"
                                      Toggled="StartupToggle_Toggled" />
                    </Grid>
                </Border>

                <!-- Close to tray -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8BB;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CloseToTrayHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="CloseToTrayDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Name="CloseToTrayToggle"
                                      Style="{StaticResource SettingsToggleStyle}"
                                      Toggled="CloseToTrayToggle_Toggled" />
                    </Grid>
                </Border>

                <!-- Hide after launching -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE921;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HideOnLaunchHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="HideOnLaunchDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Name="HideOnLaunchToggle"
                                      Style="{StaticResource SettingsToggleStyle}"
                                      Toggled="HideOnLaunchToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock x:Name="AppearanceGroupLabel"
                           Style="{StaticResource AceBodyStrongStyle}"
                           Margin="0,16,0,4" />

                <!-- Theme -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="ThemeDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  x:Name="ThemeCombo"
                                  MinWidth="160"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </Grid>
                </Border>

                <!-- Language -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageHeader" Style="{StaticResource AceBodyStyle}" />
                            <TextBlock x:Name="LanguageDesc" Style="{StaticResource AceCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  x:Name="LanguageCombo"
                                  MinWidth="160"
                                  VerticalAlignment="Center"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                    </Grid>
                </Border>

                <InfoBar x:Name="RestartInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
