<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ace_run.EditItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ace_run"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
    <StackPanel Spacing="16" MinWidth="400">
        <TextBox x:Name="DisplayNameBox"
                 x:Uid="DisplayNameBox"
                 Header="Display Name"
                 PlaceholderText="Application name" />

        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="FilePathBox"
                         x:Uid="FilePathBox"
                         Header="File Path"
                         PlaceholderText="Path to .exe file"
                         Grid.Column="0" />
                <Button x:Name="BrowseFileButton"
                        x:Uid="BrowseFileButton"
                        Content="Browse"
                        Click="BrowseFile_Click"
                        VerticalAlignment="Bottom"
                        Grid.Column="1" />
            </Grid>

            <TextBlock x:Name="ValidationText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <TextBox x:Name="ArgumentsBox"
                 x:Uid="ArgumentsBox"
                 Header="Arguments"
                 PlaceholderText="e.g. --incognito --new-window" />

        <Grid x:Name="WorkingDirectoryRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="WorkingDirectoryBox"
                     x:Uid="WorkingDirectoryBox"
                     Header="Working Directory"
                     PlaceholderText="Defaults to exe folder"
                     Grid.Column="0" />
            <Button x:Uid="BrowseFolderButton"
                    Content="Browse"
                    Click="BrowseFolder_Click"
                    VerticalAlignment="Bottom"
                    Grid.Column="1" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="CustomIconPathBox"
                     x:Uid="CustomIconPathBox"
                     Header="Custom Icon"
                     PlaceholderText="Leave empty to use default (.ico or .exe)"
                     Grid.Column="0" />
            <Button x:Uid="BrowseIconButton"
                    Content="Browse"
                    Click="BrowseIcon_Click"
                    VerticalAlignment="Bottom"
                    Grid.Column="1" />
        </Grid>

        <!-- Multi-select needs a real ListView; a MenuFlyout of toggle items would close
             on every tick, so this uses a plain Flyout that stays open while picking. -->
        <StackPanel Spacing="4">
            <TextBlock x:Name="TagFieldLabel" />
            <DropDownButton x:Name="TagDropDown"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TagSummaryDots"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center" />
                    <TextBlock x:Name="TagSummaryText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <ListView x:Name="TagListView"
                                  SelectionMode="Multiple"
                                  MinWidth="260"
                                  MaxHeight="240"
                                  Loaded="TagListView_Loaded"
                                  SelectionChanged="TagListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TagViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10"
                                                 VerticalAlignment="Center"
                                                 Fill="{x:Bind ColorBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Header and placeholder come from Loc in code rather than x:Uid. Either would work
             — MRT resolves x:Uid in this unpackaged build too — but the other half of this
             feature (the Organize menu) is built in code, so both halves read from one place. -->
        <TextBox x:Name="SortKeyBox" />

        <ToggleSwitch x:Name="RunAsAdminSwitch"
                      x:Uid="RunAsAdminSwitch"
                      Header="Run as Administrator"
                      OffContent="Off"
                      OnContent="On" />
    </StackPanel>
    </ScrollViewer>
</ContentDialog>
