<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ace_run.ManageWorkspacesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ace_run"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- The default is 548, which this row outgrows: gripper, swatch, count, "in use" and
             the overflow button take roughly 220 DIP before the name box starts. -->
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel MinWidth="500" Spacing="{StaticResource AceSpaceMd}">

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AceSpaceSm}">
            <!-- A split of one action into two, rather than a form with a radio group. Both
                 items create the row straight away and put the caret in its name box. -->
            <DropDownButton x:Name="NewWorkspaceButton">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="NewWorkspaceLabel" />
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="CreateBlankItem" Click="CreateBlank_Click" />
                        <MenuFlyoutItem x:Name="CopyCurrentItem" Click="CopyCurrent_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button x:Name="ImportButton" Click="ImportButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                    <TextBlock x:Name="ImportLabel" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar x:Name="ErrorBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True" />

        <ListView x:Name="WorkspaceListView"
                  MaxHeight="360"
                  SelectionMode="None"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True"
                  DragItemsCompleted="WorkspaceListView_DragItemsCompleted"
                  ContainerContentChanging="WorkspaceListView_ContainerContentChanging"
                  ItemContainerStyle="{StaticResource AceManageRowStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WorkspaceViewModel">
                    <Grid ColumnSpacing="{StaticResource AceSpaceSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <!-- Fixed, not Auto. Each row in a ListView measures on its own, so
                                 an Auto meta column makes the star column a different width per
                                 row: the row carrying "in use" pushed its name box visibly
                                 shorter than its neighbours'. Right-aligned inside, so the
                                 count still ends flush against the overflow button. -->
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Style="{StaticResource AceRowGripperStyle}"
                                  ToolTipService.ToolTip="{x:Bind local:ManageWorkspacesDialog.ReorderLabel}"
                                  AutomationProperties.AccessibilityView="Raw" />

                        <!-- Workspace colour was write-once at creation until this button
                             existed: ColorTag's setter had no caller anywhere in the app, even
                             though it drives the window edge, the rail selection indicator and
                             the selected tile's border. A transparent fill inside the ring is
                             what "no colour" looks like. -->
                        <Button Grid.Column="1"
                                Tag="{x:Bind}"
                                Style="{StaticResource AceSwatchButtonStyle}"
                                Click="Swatch_Click"
                                ToolTipService.ToolTip="{x:Bind ColorName, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:ManageWorkspacesDialog.ChooseColorLabel}">
                            <Ellipse Width="14" Height="14"
                                     Fill="{x:Bind ColorBrush, Mode=OneWay}"
                                     Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                     StrokeThickness="1" />
                        </Button>

                        <TextBox Grid.Column="2"
                                 Text="{x:Bind Name, Mode=OneWay}"
                                 Style="{StaticResource AceRowNameBoxStyle}"
                                 AutomationProperties.Name="{x:Bind local:ManageWorkspacesDialog.NameFieldLabel}"
                                 GotFocus="WorkspaceName_GotFocus"
                                 LostFocus="WorkspaceName_LostFocus"
                                 KeyDown="WorkspaceName_KeyDown" />

                        <!-- Which workspace is open behind this dialog was not shown anywhere,
                             although the dialog has always been told. -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AceSpaceSm}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AceCaptionStyle}"
                                       Text="{x:Bind InUseText}"
                                       Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource AceCaptionStyle}"
                                       Text="{x:Bind AppCountText, Mode=OneWay}" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Tag="{x:Bind}"
                                Style="{StaticResource AceRowIconButtonStyle}"
                                Click="More_Click"
                                ToolTipService.ToolTip="{x:Bind local:ManageWorkspacesDialog.MoreLabel}"
                                AutomationProperties.Name="{x:Bind local:ManageWorkspacesDialog.MoreLabel}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </StackPanel>
</ContentDialog>
